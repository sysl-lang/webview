module sh.sysl.webview
@tests

import sh.sysl.webview.c

@test("the version struct sysl lays out is the one C has")
layout()
    assert_eq(sizeof(c.VersionInfo), c.INFO_SIZE, "the whole struct")
    assert_eq(offsetof(c.VersionInfo, version_number), c.OFF_NUMBER, "version_number")
    assert_eq(offsetof(c.VersionInfo, pre_release), c.OFF_PRE, "pre_release")
    assert_eq(offsetof(c.VersionInfo, build_metadata), c.OFF_BUILD, "build_metadata")

@test("the library links and says which version it is")
version_reads()
    val (major, minor, patch) = version()

    assert_eq(int(major), 0, "major")
    assert_eq(int(minor), 12, "minor")

// **Success is not "not negative", and this is the test that says so.** webview's codes run from -5
// to 2 with 0 in the middle, so `>= 0` is true for `Duplicate` and `NotFound` as well as for
// success, and a caller who wrote that check would treat "no binding of that name exists" as having
// worked.
@test("webview's codes straddle zero, so a sign test is not a success test")
codes_straddle_zero()
    assert_eq(c.OK, 0, "OK")
    assert_eq(c.UNSPECIFIED, -1, "UNSPECIFIED")
    assert_eq(c.INVALID_ARGUMENT, -2, "INVALID_ARGUMENT")
    assert_eq(c.INVALID_STATE, -3, "INVALID_STATE")
    assert_eq(c.CANCELED, -4, "CANCELED")
    assert_eq(c.MISSING_DEPENDENCY, -5, "MISSING_DEPENDENCY")
    assert_eq(c.DUPLICATE, 1, "DUPLICATE is positive")
    assert_eq(c.NOT_FOUND, 2, "and so is NOT_FOUND")

    assert(c.DUPLICATE >= 0, "which is why a >= 0 check would call a duplicate a success")

@test("every code maps to an error and back to itself")
error_round_trip()
    val codes = [c.UNSPECIFIED, c.INVALID_ARGUMENT, c.INVALID_STATE, c.CANCELED,
                 c.MISSING_DEPENDENCY, c.DUPLICATE, c.NOT_FOUND]

    for i in 0..<codes.len
        assert_eq(failure(codes[i]).code(), codes[i], f"code ${codes[i]}%d survives the round trip")
        assert(failure(codes[i]).message().len > 0, f"and ${codes[i]}%d has a sentence")

// A code the binding does not know is carried rather than flattened, so a newer webview does not
// silently report the wrong thing.
@test("an unknown code is carried rather than guessed at")
unknown_code()
    failure(99) match
        Other(code) -> assert_eq(code, 99, "carried as itself")
        other       -> assert(false, f"99 is not one of webview's codes: ${other}%s")

@test("the size hints are the header's, and Start is the one that means no constraint")
hints()
    assert_eq(Hint.Start.code(), c.HINT_NONE, "Start")
    assert_eq(Hint.Minimum.code(), c.HINT_MIN, "Minimum")
    assert_eq(Hint.Maximum.code(), c.HINT_MAX, "Maximum")
    assert_eq(Hint.Fixed.code(), c.HINT_FIXED, "Fixed")

    assert_eq(c.HINT_NONE, 0, "NONE is zero, so a forgotten hint is the permissive one")

// The two callbacks are taken by address and handed to C. Nothing here calls them — that needs a
// window — but a trampoline that could not have its address taken would fail to compile, and this
// is what pins that it can. It is the fact that decides whether a `bind` can be a closure at all:
// every parameter is a pointer, so no `@export` is needed.
@test("all three trampolines have addresses C can call")
trampolines_are_addressable()
    assert(usize(&on_bound) != 0, "the bind trampoline")
    assert(usize(&on_bound_async) != 0, "the bind_async trampoline")
    assert(usize(&on_dispatch) != 0, "the dispatch trampoline")

    assert(usize(&on_bound) != usize(&on_bound_async), "bind and bind_async are two functions")
    assert(usize(&on_bound) != usize(&on_dispatch), "and so are bind and dispatch")

// ## The pump is the one new thing a machine with no window server CAN check
//
// **It needs no window** — it drives the application's event loop, which exists as soon as the
// process has the platform's toolkit in it, and `@link("webview")` puts that toolkit in every
// program built against this package. So a headless run really does take a turn of a real
// `NSApplication` loop and really does answer how many events were on it, which is none.
//
// That makes this a falsifiable check of the whole path: the shim compiled, it linked, sysl reached
// it through `extern`, and it found the platform's symbols. A `-1` here would mean it found none.
//
// **What cannot be tested here**: that a pumped loop delivers a click, that `eval` reaches the page
// between pumps, that a `bind_async` answer resolves the page's promise, and what a pump costs while
// the window sits idle. Every one needs a window, and a window needs a window server. The README
// says which program checks those and who has to run it.
@test("the pump takes a real turn of the platform's loop with no window open")
pump_runs_without_a_window()
    pump_now() match
        Ok(handled) -> assert(handled >= 0, "a turn answers how many events it dispatched")
        Err(e)      -> assert(false, f"the platform's loop should be reachable here: ${e}%s")

// Pumping is what a program does a hundred times a second, so it has to be repeatable and it has to
// leave nothing behind. The count is what says the drain terminates: an idle loop has no events, so
// a pump that answered a non-zero count every time would be dispatching something of its own.
@test("pumping again and again is idle work and stays idle")
pumping_is_repeatable()
    var total = 0

    for i in 0..<200
        pump_now() match
            Ok(handled) -> total += handled
            Err(e)      -> assert(false, f"turn ${i}%d: ${e}%s")

    assert_eq(total, 0, "two hundred turns of an idle loop dispatch nothing")

// The pump as a free call. `Webview.pump` is the same two lines with a receiver in front of them —
// the platform has one event loop however many windows are on it.
private pump_now() -> Result[int, Error]
    val handled = c.pump()

    if handled < 0 then Err(InvalidState) else Ok(handled)

// ## A registration has to land on the CALLER's webview, not on a copy of it
//
// **The receiver is the whole of what the next three check.** `bind`, `bind_async` and `dispatch`
// each build a `&` box, push it onto one of the webview's lists, and hand C the bare address inside
// it. Written with a `self` receiver they push onto a *copy* of the handle — `reference/
// declarations.md` gives `self` one meaning, *by value* — and the copy is released when the method
// returns, leaving C holding the address of a box nothing owns. The caller's list is the observable
// half of that, and it is what these assert on: empty afterwards is the defect, one entry is the fix.
//
// **A null `*c.Webview` is what makes it checkable with no window**, and `headless()` is where that
// is explained: the C call is really made, is really refused, and refuses without faulting, which
// leaves the sysl either side of it — the half that can be wrong — as the only thing under test.
//
// Somewhere for a trampoline's closure to leave a mark. A closure captures by value, so this has to
// be behind a `&` for the test to see what happened — the same fact about copies that the three
// receivers below are about.
private struct Seen
    calls: int
    call: string
    request: string

    saw(*self, call: string, request: string)
        self.calls += 1
        self.call = call
        self.request = request

@test("a bind registration is kept by the caller's webview, not by a copy of it")
bind_keeps_the_box_on_the_caller()
    var w = headless()
    val seen: &Seen = Seen(0, "", "")

    assert_eq(w.kept_bindings(), 0usize, "nothing is registered yet")

    val outcome = w.bind("add", (args) ->
        seen.saw("", args)

        Ok("3"))

    outcome match
        Ok(_)  -> assert(false, "a null handle should have been refused")
        Err(e) -> assert_eq(e.code(), c.INVALID_ARGUMENT, "and refused as an invalid argument")

    assert_eq(w.kept_bindings(), 1usize, "the box is on the caller's list, which is what keeps it alive")

    // The address C was handed, recovered the way the trampoline will be handed it, and fed to the
    // trampoline directly — which is the page's call without the page.
    val arg = w.binding_arg(0usize)

    var id: []u8 = [0; 2]
    id[0] = 0x31

    var req: []u8 = [0; 4]
    req[0] = 0x5b
    req[1] = 0x32
    req[2] = 0x5d

    on_bound(&id[0], &req[0], arg)

    // webview owns both buffers and frees them when the trampoline returns, so a closure that kept
    // what it was handed would be keeping C's storage. Overwriting them here is that freeing, and the
    // strings the closure recorded have to be untouched by it.
    req[0] = 0x58

    assert_eq(seen.calls, 1, "the trampoline reached the closure through the box the webview keeps")
    assert_eq(seen.request, "[2]", "and the request is a sysl string that owns its bytes")

@test("a bind_async registration is kept by the caller's webview, not by a copy of it")
bind_async_keeps_the_box_on_the_caller()
    var w = headless()
    val seen: &Seen = Seen(0, "", "")

    assert_eq(w.kept_async_bindings(), 0usize, "nothing is registered yet")

    val outcome = w.bind_async("load", (call, request) -> seen.saw(call, request))

    outcome match
        Ok(_)  -> assert(false, "a null handle should have been refused")
        Err(e) -> assert_eq(e.code(), c.INVALID_ARGUMENT, "and refused as an invalid argument")

    assert_eq(w.kept_async_bindings(), 1usize, "the box is on the caller's list")

    val arg = w.async_binding_arg(0usize)

    var id: []u8 = [0; 4]
    id[0] = 0x37
    id[1] = 0x38
    id[2] = 0x39

    var req: []u8 = [0; 4]
    req[0] = 0x5b
    req[1] = 0x31
    req[2] = 0x5d

    on_bound_async(&id[0], &req[0], arg)

    // The id matters more here than it does for `bind`: a deferred answer keeps it and calls
    // `answer` with it a turn later, long after webview has freed the buffer it arrived in.
    id[0] = 0x58
    req[0] = 0x58

    assert_eq(seen.calls, 1, "the trampoline reached the closure through the box the webview keeps")
    assert_eq(seen.call, "789", "the call id is copied out of C, which is what lets it be kept")
    assert_eq(seen.request, "[1]", "and so are the arguments")

@test("a dispatched closure is kept by the caller's webview, not by a copy of it")
dispatch_keeps_the_box_on_the_caller()
    var w = headless()
    val seen: &Seen = Seen(0, "", "")

    assert_eq(w.queued_work(), 0usize, "nothing is queued yet")

    val outcome = w.dispatch(() -> seen.saw("", ""))

    outcome match
        Ok(_)  -> assert(false, "a null handle should have been refused")
        Err(e) -> assert_eq(e.code(), c.INVALID_ARGUMENT, "and refused as an invalid argument")

    assert_eq(w.queued_work(), 1usize, "the work is on the caller's list until the loop has run it")
